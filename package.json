{
  "name": "jameen-game",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@cloudflare/workers-types": "^5.20261004.1",
      "@types/bun": "^1.4.2",
      "@types/node": "^22.10.2",
      "drizzle-orm": "^0.45.3",
      "typescript": "^6.0.2",
      "wrangler": "^4.70.0",
      "zod": "^4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev -F web",
    "build": "turbo run build",
    "deploy": "turbo run deploy -F web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cf-typegen": "bun run --cwd apps/web cf-typegen",
    "db:generate": "turbo run db:generate -F @jameen/db",
    "db:migrate:local": "bun run --cwd apps/web db:migrate:local",
    "db:migrate:remote": "bun run --cwd apps/web db:migrate:remote",
    "seed": "turbo run seed -F @jameen/db --",
    "reset": "rm -rf apps/web/.wrangler/state/v3/d1 && bun run db:migrate:local && bun run seed"
  },
  "devDependencies": {
    "@jameen/config": "workspace:*",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
